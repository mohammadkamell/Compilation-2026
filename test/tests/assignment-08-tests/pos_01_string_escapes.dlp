// Escape sequences in string literals are unescaped by the lexer: "a\tb\n" has
// 4 characters, "\"q\"" has 3 and "\\" has 1.
// Expected output: 4 3 1
// Expected exit code: 0
int main() {
  print_integer(length_of("a\tb\n"));
  print_integer(length_of("\"q\""));
  print_integer(length_of("\\"));
  return 0;
}
