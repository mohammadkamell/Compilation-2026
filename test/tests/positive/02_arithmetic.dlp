// Tests all arithmetic binary operators: + - * / %
// Expected output (printed by print_integer): 3 1 6 2 1
// Expected exit code: 0
var a = 1 + 2;
print_integer(a);
var b = 3 - 2;
print_integer(b);
var c = 2 * 3;
print_integer(c);
var d = 7 / 3;
print_integer(d);
var e = 7 % 3;
print_integer(e);
return 0;
